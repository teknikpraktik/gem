# Copy to .env.local for local development. NEVER commit real values.

# Postgres connection string (Neon recommended; Vercel Marketplace > Neon sets it automatically).
# Without it the app runs READ-ONLY on the research bootstrap snapshot and the cron refuses to run.
DATABASE_URL=

# Shared secret for the monthly cron. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# At least 16 characters, e.g.: openssl rand -hex 32
CRON_SECRET=

# Optional: Riksbank SWEA API subscription key (higher rate limits). Works without.
RIKSBANK_API_KEY=

# NOT used by the web app. FRED_API_KEY is a GitHub Actions secret for the research workflow only.
